{% extends 'base.html.twig' %}

{% import 'core/default_templates/form_search.html.twig' as form_search %}
{% import 'core/default_templates/data_table_macro.html.twig' as data_table %}

{% block body %}

    {{ form_search.form_search(form, ["name"]) }}

    {{ data_table.table(rows, {
        "newLink": data_table.new_btn('bank_account_create'),
            "cols" : {
            "tableAction": {
                "label": "core.module.actionTitle",
                "edit": path('bank_account_edit', {"id": -1}),
            },
            "name": {
                "label": "bank_account.name",
            },
            "bankName": {
                "label": "bank_account.bankName",
            },
            "iban": {
                "label": "bank_account.iban",
            },
            "swift": {
                "label": "bank_account.swift",
            },
        }
     }) }}

{% endblock %}

